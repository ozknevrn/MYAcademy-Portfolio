@model List<Contact>
@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    <div class="content-header-row">
        <div>
            <h1 class="page-title">İletişim Bilgileri</h1>
            <p class="page-subtitle">Sitenin iletişim bölümünde ilk kayıt gösterilir. Sosyal medya bağlantıları için <a href="/Admin/SocialMedia/SocialMediaList">Sosyal Medya</a> sayfasını kullanın.</p>
        </div>
        <div class="header-actions">
            <a href="/Admin/Contact/CreateContact" class="btn-pastel-primary">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Kayıt</span>
            </a>
        </div>
    </div>

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Başlık</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th>Konum</th>
                        <th style="text-align: right; width: 120px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="empty-state">Henüz iletişim bilgisi eklenmemiş.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.ContactId</td>
                            <td>
                                <span class="exp-title-text">@item.Title</span>
                                <small class="text-muted d-block" style="font-size:0.75rem;">@item.Description</small>
                            </td>
                            <td>@item.Email</td>
                            <td>@(item.PhoneNumber ?? "-")</td>
                            <td>@(item.Location ?? "-")</td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a href="/Admin/Contact/UpdateContact/@item.ContactId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="/Admin/Contact/DeleteContact/@item.ContactId" class="btn-action-icon btn-delete js-confirm-delete" title="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
