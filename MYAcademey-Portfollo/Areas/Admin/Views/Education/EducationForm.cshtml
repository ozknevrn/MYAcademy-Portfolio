@model Education
@{
    ViewData["Title"] = ViewBag.FormTitle;
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    <div class="content-header-row">
        <div>
            <h1 class="page-title">@ViewBag.FormTitle</h1>
        </div>
    </div>

    <div class="form-card">
        <form method="post">
            <input type="hidden" asp-for="EducationId" />

            <div class="form-group-custom">
                <label asp-for="Title" class="form-label-custom">Bölüm / Program <span class="required-star">*</span></label>
                <input asp-for="Title" class="form-control-custom" placeholder="Ör: Lisans — Bilgisayar Mühendisliği" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            <div class="row">
                <div class="col-md-8 form-group-custom">
                    <label asp-for="SchoolName" class="form-label-custom">Okul / Kurum</label>
                    <input asp-for="SchoolName" class="form-control-custom" />
                    <span asp-validation-for="SchoolName" class="field-error"></span>
                </div>
                <div class="col-md-4 form-group-custom">
                    <label asp-for="BadgeText" class="form-label-custom">Etiket</label>
                    <input asp-for="BadgeText" class="form-control-custom" placeholder="Ör: Mezun, Devam Ediyor" />
                    <span asp-validation-for="BadgeText" class="field-error"></span>
                </div>
            </div>

            <div class="form-group-custom">
                <label asp-for="Description" class="form-label-custom">Açıklama</label>
                <textarea asp-for="Description" class="form-control-custom" rows="3"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>

            <div class="form-group-custom form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label">Aktif (sitede gösterilsin)</label>
            </div>

            <div class="form-actions">
                <a href="/Admin/Education/EducationList" class="btn-pastel-secondary">Vazgeç</a>
                <button type="submit" class="btn-pastel-primary">Kaydet</button>
            </div>
        </form>
    </div>
</main>
