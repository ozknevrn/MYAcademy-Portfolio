@model List<Education>
@{
    ViewData["Title"] = "Eğitim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Eğitim Bilgilerim</h1>
            <p class="page-subtitle">Sitedeki "Eğitim Hayatım" bölümünde listelenir. Pasif kayıtlar gösterilmez.</p>
        </div>
        <div class="header-actions">
            <a href="/Admin/Education/CreateEducation" class="btn-pastel-primary">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Eğitim</span>
            </a>
        </div>
    </div>

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Bölüm / Program</th>
                        <th>Okul</th>
                        <th>Etiket</th>
                        <th>Durum</th>
                        <th style="text-align: right; width: 120px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="empty-state">Henüz eğitim bilgisi eklenmemiş.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.EducationId</td>
                            <td>
                                <span class="exp-title-text">@item.Title</span>
                                <small class="text-muted d-block" style="font-size:0.75rem;">@item.Description</small>
                            </td>
                            <td>@(item.SchoolName ?? "-")</td>
                            <td><span class="work-type-badge">@(item.BadgeText ?? "-")</span></td>
                            <td>
                                <a href="/Admin/Education/ToggleEducationStatus/@item.EducationId" class="text-decoration-none" title="Durumu değiştir">
                                    <span class="status-pill @(item.IsActive ? "status-active" : "status-passive")">@(item.IsActive ? "Aktif" : "Pasif")</span>
                                </a>
                            </td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a href="/Admin/Education/UpdateEducation/@item.EducationId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="/Admin/Education/DeleteEducation/@item.EducationId" class="btn-action-icon btn-delete js-confirm-delete" title="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
