@model List<Project>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Projelerim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    string sort = ViewBag.Sort ?? "newest";
    string status = ViewBag.Status ?? "";

    var statusItems = new List<SelectListItem>
    {
        new SelectListItem("Durum (Tümü)", "", status == ""),
        new SelectListItem("Aktif", "active", status == "active"),
        new SelectListItem("Pasif", "passive", status == "passive")
    };

    var sortItems = new List<SelectListItem>
    {
        new SelectListItem("En yeni proje", "newest", sort == "newest"),
        new SelectListItem("En eski proje", "oldest", sort == "oldest"),
        new SelectListItem("Ada göre (A-Z)", "title", sort == "title")
    };
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Projelerim</h1>
            <p class="page-subtitle">Pasif projeler burada yönetilebilir ancak sitede listelenmez.</p>
        </div>
        <div class="header-actions">
            <a href="/Admin/Category/CategoryList" class="btn-pastel-secondary">
                <i class="bi bi-tags"></i>
                <span>Kategoriler</span>
            </a>
            <a href="/Admin/Project/CreateProject" class="btn-pastel-primary">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Proje</span>
            </a>
        </div>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-green"><i class="bi bi-folder2-open"></i></div>
            <div class="stat-content">
                <span class="stat-label">Toplam Proje</span>
                <h3 class="stat-value">@ViewBag.TotalCount</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-blue"><i class="bi bi-check2-circle"></i></div>
            <div class="stat-content">
                <span class="stat-label">Aktif</span>
                <h3 class="stat-value">@ViewBag.ActiveCount</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-beige"><i class="bi bi-pause-circle"></i></div>
            <div class="stat-content">
                <span class="stat-label">Pasif</span>
                <h3 class="stat-value">@ViewBag.PassiveCount</h3>
            </div>
        </div>
    </div>

    <div class="data-table-card">

        <!-- Filtreler: GET formu, seçimler adres çubuğuna yazılır -->
        <form method="get" class="table-filter-bar">
            <div class="filters-left-group">
                <div class="filter-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="Proje adı veya teknoloji ara...">
                </div>

                <select name="categoryId" class="filter-select" asp-items="ViewBag.Categories" onchange="this.form.submit()">
                    <option value="">Tüm Kategoriler</option>
                </select>

                <select name="status" class="filter-select" asp-items="statusItems" onchange="this.form.submit()"></select>

                <select name="sort" class="filter-select" asp-items="sortItems" onchange="this.form.submit()"></select>
            </div>
            <div class="filters-right-group">
                <button type="submit" class="btn-table-util"><i class="bi bi-funnel"></i> <span class="d-none d-md-inline">Filtrele</span></button>
                <a href="/Admin/Project/ProjectList" class="btn-table-util text-decoration-none"><i class="bi bi-arrow-counterclockwise"></i> <span class="d-none d-md-inline">Temizle</span></a>
            </div>
        </form>

        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">Görsel</th>
                        <th>Proje</th>
                        <th>Kategori</th>
                        <th>Eklenme</th>
                        <th>Durum</th>
                        <th style="text-align: right; width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="empty-state">Kriterlere uygun proje bulunamadı.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.ProjectTitle" class="table-thumb" />
                                }
                                else
                                {
                                    <span class="table-thumb-empty"><i class="bi bi-image"></i></span>
                                }
                            </td>
                            <td>
                                <span class="exp-title-text">@item.ProjectTitle</span>
                                <small class="text-muted d-block" style="font-size:0.75rem;">@item.Technologies</small>
                            </td>
                            <td><span class="work-type-badge">@(item.Category?.CategoryName ?? "-")</span></td>
                            <td><span class="date-badge"><i class="bi bi-calendar2"></i> @item.CreatedDate.ToString("dd MMM yyyy")</span></td>
                            <td>
                                <a href="/Admin/Project/ToggleProjectStatus/@item.ProjectId" class="text-decoration-none" title="Durumu değiştirmek için tıklayın">
                                    @if (item.IsActive)
                                    {
                                        <span class="status-pill status-active">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-passive">Pasif</span>
                                    }
                                </a>
                            </td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a href="/Admin/Project/ToggleProjectStatus/@item.ProjectId" class="btn-action-icon btn-view" title="@(item.IsActive ? "Pasif yap" : "Aktif yap")">
                                        <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                    </a>
                                    <a href="/Admin/Project/UpdateProject/@item.ProjectId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="/Admin/Project/DeleteProject/@item.ProjectId" class="btn-action-icon btn-delete js-confirm-delete"
                                       data-text="'@item.ProjectTitle' projesi ve görseli silinecek." title="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer-area">
            <span class="pagination-counter">Listelenen: <strong>@Model.Count</strong> proje</span>
        </div>
    </div>
</main>
