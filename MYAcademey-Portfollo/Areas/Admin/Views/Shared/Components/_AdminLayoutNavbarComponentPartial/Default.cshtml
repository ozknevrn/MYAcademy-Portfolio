@{
    int unreadCount = ViewBag.UnreadMessageCount ?? 0;
    var pageTitle = ViewContext.ViewData["Title"]?.ToString() ?? "Yönetim Paneli";
}

<header class="admin-navbar">
    <div class="navbar-left">
        <button class="sidebar-toggle-btn" id="sidebarToggle" aria-label="Menüyü Aç/Kapat">
            <i class="bi bi-list"></i>
        </button>
        <div class="breadcrumb-custom">
            <a href="/Admin/Dashboard/Index"><i class="bi bi-house me-1"></i> Dashboard</a>
            <span class="separator">/</span>
            <span class="active-crumb">@pageTitle</span>
        </div>
    </div>

    <div class="navbar-right">
       
        <form class="nav-search-box" method="get" action="/Admin/Message/MessageList">
            <i class="bi bi-search"></i>
            <input type="text" name="search" placeholder="Mesajlarda ara..." id="navQuickSearch">
        </form>

       
        <a href="/Admin/Project/CreateProject" class="btn-quick-add text-decoration-none">
            <i class="bi bi-plus-lg"></i>
            <span>Yeni Proje</span>
        </a>

        
        <a href="/Admin/Message/MessageList?status=unread" class="icon-action-btn" title="Okunmamış mesajlar (@unreadCount)">
            <i class="bi bi-bell"></i>
            @if (unreadCount > 0)
            {
                <span class="notification-dot"></span>
            }
        </a>

      
        <a href="/Admin/Message/MessageList" class="icon-action-btn" title="Gelen Mesajlar">
            <i class="bi bi-chat-left-text"></i>
        </a>

       
        <div class="nav-profile-pill">
            <div class="nav-avatar-mini">ÖE</div>
            <span class="d-none d-sm-inline" style="font-size:0.825rem; font-weight:600;">Özkan Evren</span>
        </div>
    </div>
</header>
