<!-- jQuery + doğrulama kütüphaneleri (asp-validation-for mesajlarının tarayıcıda da çalışması için) -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    (function () {
        const sidebar = document.getElementById('adminSidebar');
        const sidebarToggle = document.getElementById('sidebarToggle');
        if (!sidebar || !sidebarToggle) return;

        sidebarToggle.addEventListener('click', () => sidebar.classList.toggle('show-sidebar'));

        document.addEventListener('click', (e) => {
            if (window.innerWidth <= 991.98 && !sidebar.contains(e.target) && !sidebarToggle.contains(e.target)) {
                sidebar.classList.remove('show-sidebar');
            }
        });
    })();

    
    document.addEventListener('click', function (e) {
        const link = e.target.closest('.js-confirm-delete');
        if (!link) return;

        e.preventDefault();
        Swal.fire({
            title: link.dataset.title || 'Emin misiniz?',
            text: link.dataset.text || 'Bu kayıt kalıcı olarak silinecek.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, sil',
            cancelButtonText: 'Vazgeç',
            confirmButtonColor: '#B55454',
            cancelButtonColor: '#9BB7A2',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = link.getAttribute('href');
            }
        });
    });

  
    (function () {
        const flash = document.getElementById('flashMessages');
        if (!flash) return;

        const toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
        });

        if (flash.dataset.success) {
            toast.fire({ icon: 'success', title: flash.dataset.success });
        } else if (flash.dataset.error) {
            toast.fire({ icon: 'error', title: flash.dataset.error });
        }
    })();

  
    document.addEventListener('change', function (e) {
        const input = e.target;
        if (input.type !== 'file' || !input.dataset.preview) return;

        const img = document.querySelector(input.dataset.preview);
        const file = input.files && input.files[0];
        if (!img || !file) return;

        img.src = URL.createObjectURL(file);
        img.classList.remove('d-none');
    });
</script>
