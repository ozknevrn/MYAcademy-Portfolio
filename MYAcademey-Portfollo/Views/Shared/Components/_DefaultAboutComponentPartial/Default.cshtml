@model About?
@{
    var hero = ViewBag.Hero as HeroSection;
    int activeProjectCount = ViewBag.ActiveProjectCount ?? 0;
    var imageUrl = string.IsNullOrWhiteSpace(Model?.ImageUrl)
        ? (string.IsNullOrWhiteSpace(hero?.MainImageUrl) ? null : hero!.MainImageUrl)
        : Model!.ImageUrl;

    // Admin panelinde boş satırla ayrılan metin paragraflara bölünür
    var paragraphs = (Model?.Description ?? "")
        .Replace("\r\n", "\n")
        .Split("\n\n", StringSplitOptions.RemoveEmptyEntries);
}

<section id="about" class="bg-white border-top border-bottom">
    <div class="container">
        <div class="row align-items-center gy-5">
            <!-- Left Column: Portrait -->
            <div class="col-lg-5 reveal-on-scroll">
                <div class="about-img-wrap">
                    @if (imageUrl != null)
                    {
                        <img src="@imageUrl" alt="@(hero?.Greeting)" class="w-100" style="height: 540px; object-fit: cover; object-position: center top;">
                    }
                    else
                    {
                        <div class="w-100 d-flex align-items-center justify-content-center bg-light" style="height: 540px;">
                            <i class="bi bi-person-circle text-muted" style="font-size: 6rem;"></i>
                        </div>
                    }
                    <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                        <span class="small text-muted font-heading">@(hero?.Greeting)</span>
                        <span class="badge bg-secondary-subtle text-dark fw-medium">@(hero?.Title)</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Story & Stats -->
            <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                <div class="eyebrow-badge">
                    <i class="bi bi-person-lines-fill"></i> BENİ TANIYIN
                </div>
                <h2 class="section-title">
                    @(Model?.Title ?? "Hakkımda")
                </h2>
                <div class="text-muted fs-5 mb-4 lh-base">
                    @if (!paragraphs.Any())
                    {
                        <p class="mb-3">Hakkımda yazısı henüz eklenmedi.</p>
                    }
                    @foreach (var paragraph in paragraphs)
                    {
                        <p class="mb-3">@paragraph</p>
                    }
                </div>

                <!-- Statistics -->
                <div class="row g-4 pt-2 pb-4 border-top border-bottom mb-4">
                    <div class="col-4">
                        <div class="stat-number">@(hero?.ExperienceYear ?? "-")</div>
                        <div class="stat-label">Yıl Deneyim</div>
                    </div>
                    <div class="col-4">
                        <div class="stat-number">@activeProjectCount</div>
                        <div class="stat-label">Proje</div>
                    </div>
                    <div class="col-4">
                        <div class="stat-number">@(hero?.StudentCount ?? "-")</div>
                        <div class="stat-label">Öğrenci</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <a href="#projects" class="btn-sage">
                        <i class="bi bi-folder2-open"></i>
                        <span>Projelerimi İncele</span>
                    </a>
                    <a href="#contact" class="btn-secondary-custom">
                        <span>Bana Ulaşın</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
